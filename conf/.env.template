DATABASE_URL="postgresql://__DB_USER__:__DB_PWD__@localhost:5432/__DB_NAME__"
NODE_ENV="production"
PORT=__PORT__
SESSION_SECRET="__SESSION_SECRET__"
LOG_LEVEL="info"

MISTRAL_API_KEY="__MISTRAL_API_KEY__"
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
DEFAULT_LLM_PROVIDER="mistral"

OLLAMA_BASE_URL="__OLLAMA_BASE_URL__"
OLLAMA_MODEL="qwen2.5:7b-instruct-q4_K_M"

APP_BASE_URL="https://__DOMAIN____PATH__"
YESWIKI_BASE_URL="https://labovilleurbanne.fr/yeswiki/"

NEXT_BASE_PATH="__NEXT_BASE_PATH__"
NEXT_PUBLIC_BASE_PATH="__NEXT_BASE_PATH__"

# Protected by the dedicated YunoHost admin permission.
RAG_REFRESH_ENABLED="true"

# Admin area: nginx sets X-Lov-Admin only behind the YunoHost `admin` permission.
TRUST_PROXY_ADMIN_HEADER="true"
# Encrypts secrets stored in the database (Framateam password). Generated at install.
APP_ENCRYPTION_KEY="__APP_ENCRYPTION_KEY__"
# Framateam is configured from /admin/framateam. FRAMATEAM_* variables are an optional fallback.
